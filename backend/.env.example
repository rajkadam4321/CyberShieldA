# CyberShield Backend Environment Configuration
# Generate a secure 32+ byte random secret for production:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-secure-random-key-for-production

# Database URL
# Local Development (SQLite):
# DATABASE_URL=sqlite:///./cybershield.db
# Production Managed PostgreSQL (Supabase / Render / Neon):
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./cybershield.db

# JWT Access Token Lifetime in Minutes
ACCESS_TOKEN_MINUTES=60

# Max Upload Size in Megabytes for Static File Analysis
MAX_UPLOAD_MB=5

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
# Example for production: https://cybershield.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional CORS Regex for Vercel Preview Deployments (*.vercel.app)
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Optional custom path to trained ML model artifact (defaults to models/url_model.joblib)
# MODEL_PATH=models/url_model.joblib
