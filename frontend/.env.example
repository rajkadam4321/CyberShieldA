# Example frontend environment variables for CyberShield on Vercel
# In production on Vercel, set VITE_API_BASE_URL to your Render backend HTTPS URL.
# Example: https://cybershield-api.onrender.com (without trailing slash)
# During local development, leave empty or omit to use the Vite dev proxy to http://127.0.0.1:8000
VITE_API_BASE_URL=https://cybershield-api.onrender.com
